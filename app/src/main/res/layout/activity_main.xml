<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F7F2">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp"
        android:background="#315C43">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TUGASPAB"
            android:textColor="#D7E8D8"
            android:textStyle="bold"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/headerTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Halo, Pengguna!"
            android:textColor="#FFFFFF"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/headerSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Selamat datang di aplikasi kamu."
            android:textColor="#E2EDE3"
            android:textSize="14sp" />

    </LinearLayout>

    <!-- Area halaman -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="18dp">

            <!-- HOME -->
            <LinearLayout
                android:id="@+id/homePage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="22dp"
                android:background="#FFFFFF">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🏡"
                    android:textSize="38sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Beranda"
                    android:textSize="23sp"
                    android:textStyle="bold"
                    android:textColor="#315C43" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Jelajahi aplikasi dan atur profil kamu melalui menu di bawah."
                    android:textSize="15sp"
                    android:textColor="#626B63" />

                <Button
                    android:id="@+id/btnMulai"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="Lengkapi Profil"
                    android:textAllCaps="false"
                    android:backgroundTint="#315C43" />

            </LinearLayout>

            <!-- PROFIL -->
            <LinearLayout
                android:id="@+id/profilePage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="22dp"
                android:background="#FFFFFF"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Profil Saya"
                    android:textSize="23sp"
                    android:textStyle="bold"
                    android:textColor="#315C43" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Isi informasi berikut."
                    android:textSize="14sp"
                    android:textColor="#626B63" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="Nama lengkap"
                    android:textStyle="bold"
                    android:textColor="#333333" />

                <EditText
                    android:id="@+id/inputNama"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Masukkan nama kamu"
                    android:inputType="textPersonName"
                    android:singleLine="true"
                    android:padding="12dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Email"
                    android:textStyle="bold"
                    android:textColor="#333333" />

                <EditText
                    android:id="@+id/inputEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Masukkan email kamu"
                    android:inputType="textEmailAddress"
                    android:singleLine="true"
                    android:padding="12dp" />

                <Button
                    android:id="@+id/btnSimpan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="Simpan Profil"
                    android:textAllCaps="false"
                    android:backgroundTint="#315C43" />

                <TextView
                    android:id="@+id/hasilProfil"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:textColor="#315C43"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- PENGATURAN -->
            <LinearLayout
                android:id="@+id/settingsPage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="22dp"
                android:background="#FFFFFF"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Pengaturan"
                    android:textSize="23sp"
                    android:textStyle="bold"
                    android:textColor="#315C43" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Sesuaikan aplikasi sesuai kebutuhanmu."
                    android:textColor="#626B63"
                    android:textSize="14sp" />

                <Switch
                    android:id="@+id/switchNotifikasi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="Aktifkan notifikasi"
                    android:textColor="#333333"
                    android:checked="true" />

                <Switch
                    android:id="@+id/switchTema"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Mode gelap"
                    android:textColor="#333333" />

                <TextView
                    android:id="@+id/hasilPengaturan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="Notifikasi aktif"
                    android:textColor="#315C43"
                    android:textSize="14sp" />

            </LinearLayout>

        </FrameLayout>
    </ScrollView>

    <!-- Navigasi bawah -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="6dp"
        android:background="#FFFFFF">

        <Button
            android:id="@+id/btnHome"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:text="Home"
            android:textAllCaps="false"
            android:textSize="12sp"
            android:minWidth="0dp"
            android:backgroundTint="#315C43" />

        <Button
            android:id="@+id/btnProfil"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:text="Profil"
            android:textAllCaps="false"
            android:textSize="12sp"
            android:minWidth="0dp"
            android:backgroundTint="#E8EDE7" />

        <Button
            android:id="@+id/btnPengaturan"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:text="Setelan"
            android:textAllCaps="false"
            android:textSize="12sp"
            android:minWidth="0dp"
            android:backgroundTint="#E8EDE7" />

    </LinearLayout>

</LinearLayout>
